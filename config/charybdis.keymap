#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define U_TAPPING_TERM 200

#if defined(CONFIG_SHIELD_CHARYBDIS_RIGHT)

#define CPI_CYCLE_FORWARD_BINDING &cpi_cycle 1
#define CPI_CYCLE_BACKWARD_BINDING &cpi_cycle 3

#else

#define CPI_CYCLE_FORWARD_BINDING &none
#define CPI_CYCLE_BACKWARD_BINDING &none

#endif

&lt {
    tapping-term-ms = < U_TAPPING_TERM >;
    quick-tap-ms = < U_TAPPING_TERM >;
    flavor = "tap-preferred";
};

/ {
    chosen { zmk,matrix_transform = &default_transform; };
};

/ {
    behaviors {
        hrm_right: hrm_right {
            compatible = "zmk,behavior-hold-tap";
            label = "Homerow Mods Right";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32>;
        };

        hrm_left: hrm_left {
            compatible = "zmk,behavior-hold-tap";
            label = "Homerow Mods Left";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 33 34>;
        };

        bspc_del: backspace_delete {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp DELETE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_RSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        toggle_mouse_layer {
            bindings = <&tog 3>;
            key-positions = <33 9>;
        };

        return_base_layer {
            bindings = <&to 0>;
            key-positions = <5 33>;
        };

        // " : ; '
        combo_double_qoutes {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <1 2>;
        };
        combo_colon {
            bindings = <&kp COLON>;
            key-positions = <2 3>;
        };

        combo_semi_colon {
            bindings = <&kp SEMICOLON>;
            key-positions = <6 7>;
        };
        combo_single_qoutes {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <7 8>;
        };

        // ^#! ?*$
        combo_caret {
            bindings = <&kp CARET>;
            key-positions = <1 11>;
        };
        combo_hash {
            bindings = <&kp HASH>;
            key-positions = <2 12>;
        };
        combo_exclamation {
            bindings = <&kp EXCLAMATION>;
            key-positions = <3 13>;
        };

        combo_question_mark {
            bindings = <&kp QUESTION>;
            key-positions = <6 16>;
        };
        combo_asterisk {
            bindings = <&kp ASTERISK>;
            key-positions = <7 17>;
        };
        combo_dollar {
            bindings = <&kp DOLLAR>;
            key-positions = <8 18>;
        };

        // <> () {} []
        combo_lt {
            bindings = <&kp LESS_THAN>;
            key-positions = <13 14>;
        };
        combo_gt {
            bindings = <&kp GREATER_THAN>;
            key-positions = <15 16>;
        };

        combo_paren_s {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <12 13>;
        };
        combo_paren_e {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <16 17>;
        };

        combo_brace_s {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <11 12>;
        };
        combo_brace_e {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <17 18>;
        };

        combo_bracket_s {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <20 11>;
        };
        combo_bracket_e {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <18 29>;
        };

        // @ %
        combo_at {
            bindings = <&kp AT>;
            key-positions = <13 23>;
        };
        combo_percent {
            bindings = <&kp PERCENT>;
            key-positions = <16 26>;
        };
    };

    macros {
        zed_em_kay: zed_em_kay {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LSHFT>
                , <&macro_tap &kp Z &kp M &kp K>
                , <&macro_release &kp LSHFT>
                ;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            bindings = <
&kp Q             &kp L              &kp D              &kp W              &kp Z                  &kp EQUAL        &kp F                &kp O               &kp U               &kp UNDERSCORE
&hrm_left LCMD B  &hrm_left LALT R   &hrm_left LCTRL T  &hrm_left LSHFT S  &kp G                  &kp Y            &hrm_right RSHIFT H  &hrm_right RCTRL A  &hrm_right LALT E   &hrm_right RCMD J
&kp N             &kp X              &kp M              &kp C              &kp V                  &kp K            &kp P                &kp PERIOD          &kp COMMA           &kp I
                                     &kp ESCAPE         &lt 4 ENTER        &mo 2                  &kp SPACE        &mo 1
            >;
        };

        NUM_SYM {
            bindings = <
&kp TILDE  &kp N7  &kp N8  &kp N9  &kp GRAVE          &trans         &kp CARET      &kp AMPERSAND  &kp PIPE      &kp DOLLAR 
&kp AT     &kp N4  &kp N5  &kp N6  &kp BACKSLASH      &kp SLASH      &kp MINUS      &kp PLUS       &kp ASTERISK  &kp HASH
&kp N0     &kp N1  &kp N2  &kp N3  &kp COLON          &kp SEMICOLON  &kp PERCENT    &trans         &trans        &kp EXCLAMATION
                   &trans  &trans  &trans             &trans     &trans
            >;
        };

        NAV {
            bindings = <
&kp LG(TAB)  &kp LA(TAB)  &kp LG(LC(LEFT))  &kp LG(LC(RIGHT))  &mo 5                   &trans     &kp LC(LS(TAB))  &kp LC(TAB)  &kp PRINTSCREEN  &kp INSERT
&kp LCMD     &kp LALT     &kp LCTRL         &kp LSHIFT         &mo 3                   &kp LEFT   &kp DOWN         &kp UP       &kp RIGHT        &trans
&kp LS(TAB)  &mkp MCLK    &mkp RCLK         &mkp LCLK          &kp K_CMENU             &kp HOME   &kp PAGE_DOWN    &kp PAGE_UP  &kp END          &kp CAPS
                          &trans            &trans             &trans                  &bspc_del  &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                   &trans  CPI_CYCLE_BACKWARD_BINDING  CPI_CYCLE_FORWARD_BINDING  &trans  &trans
&trans  &trans  &trans  &trans  &trans                   &trans  &trans                      &trans                     &trans  &trans
&trans  &trans  &trans  &trans  &trans                   &trans  &trans                      &trans                     &trans  &trans
&trans  &trans  &trans  &trans  &trans                   &trans  &trans                      &trans                     &trans  &trans
                &trans  &trans  &trans                   &trans  &trans
            >;
        };

        MEDIA_FUNCTION {
            bindings = <
&kp F1    &kp F2    &kp F3     &kp F4      &kp F5           &kp F6        &kp F7        &kp F8        &kp F9        &kp F10
&sk LCMD  &sk LALT  &sk LCTRL  &sk LSHIFT  &kp F11          &kp C_PREV    &kp C_PP      &kp C_MUTE    &kp C_NEXT    &trans
&trans    &trans    &trans     &trans      &kp F12          &kp C_BRI_DN  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_BRI_UP  &trans
                    &trans     &trans      &trans           &trans        &trans
            >;
        };

        keyboard_controls {
            bindings = <
&bootloader  &sys_reset  &trans  &trans  &trans          &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans       &trans      &trans  &trans  &trans          &bt BT_CLR    &bt BT_CLR_ALL  &bt BT_NXT    &bt BT_PRV    &trans
&trans       &trans      &trans  &trans  &trans          &trans        &trans          &trans        &trans        &trans
                         &trans  &trans  &trans          &trans        &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans          &trans  &trans
            >;
        };
    };
};